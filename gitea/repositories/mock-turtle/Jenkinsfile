pipeline {
    agent any
    stages {
        stage('pr_checks') {
            steps {
                script {
                    // Only run PR checks if this is a pull request build
                    if (env.CHANGE_ID) {
                        sh '''
                            # Check if Jenkinsfile has been modified in this PR
                            if git diff --name-only origin/${CHANGE_TARGET} | grep -q '^Jenkinsfile$'; then
                                echo "ERROR: Pull requests must not modify the Jenkinsfile"
                                echo "Jenkinsfile changes require independent maintainer review and approval"
                                exit 1
                            fi
                            
                            # Validate version file format if it exists and was changed
                            if [ -f version ] && git diff --name-only origin/${CHANGE_TARGET} | grep -q '^version$'; then
                                if [ $(wc -l <version) -ne 1 ]; then
                                    echo "ERROR: version file must contain exactly one line"
                                    exit 1
                                fi
                                if ! grep -Pq "^\\d{1,2}\\.\\d{1,2}\\.\\d{1,2}$" version; then
                                    echo "ERROR: version file must contain a valid semantic version (e.g., 1.0.0)"
                                    exit 1
                                fi
                            fi
                            
                            echo "PR validation checks passed"
                            echo "This PR requires manual review and approval by a maintainer before merging"
                        '''
                    } else {
                        echo "Not a pull request build, skipping PR checks"
                    }
                }
            }
        }
    }
}
