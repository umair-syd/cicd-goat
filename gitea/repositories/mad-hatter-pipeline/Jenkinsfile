pipeline {
    agent any
    environment {
        PROJECT = "yagmail"
    }

    stages {
        stage ('Install_Requirements') {
            steps {
                sh """
                    virtualenv venv
                    pip3 install -r requirements.txt || true
                """
            }
        }

        stage ('Lint') {
            steps {
                sh "pylint ${PROJECT} || true"
            }
        }

        stage ('Unit Tests') {
            steps {
                sh "pytest || true"
            }
        }

        stage('make'){
            steps {
                sh 'make || true'
            }           
        }
    }

    post { 
        always { 
            cleanWs()
        }
    }
}

