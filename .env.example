# Jenkins User Passwords
# Copy this file to .env and set secure passwords before deploying
# These passwords will be used for Jenkins local user accounts

# Administrator account password (has Overall/Administer permissions)
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Alice account password (has build and job permissions)
ALICE_PASSWORD=CHANGE_ME_ALICE_PASSWORD

# Knave account password (has agent management permissions)
KNAVE_PASSWORD=CHANGE_ME_KNAVE_PASSWORD
