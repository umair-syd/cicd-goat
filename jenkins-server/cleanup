#!/bin/sh
# Note: With the security fix, secrets.properties, jenkins.yaml, and jobdsl/ are mounted
# as read-only volumes at runtime and cannot be deleted from the container filesystem.
# This cleanup script is retained for compatibility but the rm commands will fail silently
# on read-only mounts, which is the expected and secure behavior.
sh -c "sleep 300 && rm -rf /var/jenkins_home/jobdsl 2>/dev/null; rm /var/jenkins_home/secrets.properties 2>/dev/null; rm /var/jenkins_home/jenkins.yaml 2>/dev/null" &
/sbin/tini -- /usr/local/bin/jenkins.sh
